def dfs(r, c):
    
    if maze[r][c]==3:
        return True
    
    visited[r][c] = True
    
    for d in range(4):
        nr = r + dr[d]
        nc = c + dc[d]
        
        if maze[nr][nc]!=1 and not visited[nr][nc]:
            if dfs(nr, nc):
                return True
    
    return False
        
for _ in range(10):
    tc = int(input())
    
    maze = [list(map(int, input())) for _ in range(16)]
    
    visited = [[False]*16 for _ in range(16)]
    
    dr = [0, 0, -1, 1]
    dc = [1, -1, 0, 0]
    
    result = dfs(1,1)
    
    print(f'#{tc} {int(result)}')