T = int(input())

for tc in range(1, T+1):
    inpt = input()
    
    stack = []
    
    result = 0
    
    for i in range(len(inpt)):
        if inpt[i]=="(":
            stack.append("(")
            
        elif inpt[i] == ")":
            
            if inpt[i-1] == "(":
                stack.pop()
                result += len(stack)
                
            else:
                stack.pop()
                result += 1
        
    
    print(f'#{tc} {result}')