import java.util.Arrays;
import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        for (int tc = 1; tc <= T; tc++) {
            int N = sc.nextInt();
            int M = sc.nextInt();

            int[] snacks = new int[N];

            for (int i = 0; i < N; i++) {
                snacks[i] = sc.nextInt();
            }

            // 투 포인터를 사용하기 위해 정렬
            Arrays.sort(snacks);

            int left = 0;
            int right = N - 1;

            int result = -1;

            while (left < right) {
                int current = snacks[left] + snacks[right];

                // 합이 제한 무게보다 크면
                // 큰 값을 줄여야 하므로 오른쪽 포인터 이동
                if (current > M) {
                    right--;
                }

                // 합이 제한 무게 이하라면 정답 후보
                else {
                    result = Math.max(result, current);

                    // M과 같다면 더 큰 답은 없으므로 종료
                    if (current == M) {
                        break;
                    }

                    // 더 큰 합을 찾기 위해 왼쪽 포인터 이동
                    left++;
                }
            }

            System.out.println("#" + tc + " " + result);
        }

        sc.close();
    }
}