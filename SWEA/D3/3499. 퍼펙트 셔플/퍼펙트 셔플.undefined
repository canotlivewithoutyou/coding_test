T = int(input())

for tc in range(1, T+1):
    N= int(input())
    cards = input().split()
    
    mid = (N+1)//2
    
    top = cards[:mid]
    bottom = cards[mid:]
    
    result =[]
    
    for a, b in zip(top, bottom):
        result.extend([a,b])
        
    if N%2!=0:
        result.append(top[-1])
    
    print(f'#{tc}', *result)